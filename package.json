{
  "name": "democraxssy-backend",
  "version": "1.0.0",
  "description": "Backend (Node.js + Express + SQLite) para el juego DemocraXSSy",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
